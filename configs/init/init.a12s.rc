on init && property:ro.boot.em.model=SM-A127F
    setprop ro.boot.product.hardware.sku ${ro.boot.hardware.sku}

on init && property:ro.boot.em.model=SM-A127M
    setprop ro.boot.product.hardware.sku disabled

on early-fs && property:ro.boot.em.model=SM-A127M
